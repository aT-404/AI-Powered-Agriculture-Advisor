# ==============================================================================
# AI-Powered Agriculture Advisor - Environment Variables Configuration
# ==============================================================================

# Backend Django Settings
SECRET_KEY=django-insecure-cropwise-agriculture-advisor-key-for-dev
DEBUG=True
ALLOWED_HOSTS=*

# Market Intelligence Integration
# Optional: API key for official Indian Government Agmarknet data via Data.gov.in
# Register and generate key at: https://data.gov.in
DATA_GOV_IN_API_KEY=

# Weather Integration (Open-Meteo)
# Open-Meteo does not require an API key for open standard agricultural usage.

# Frontend Configuration (Expo / React Native)
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api
